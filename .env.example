# Sitenin canonical kökü — ZORUNLU.
# canonical, hreflang, sitemap, robots, Restaurant JSON-LD ve OG görseli bunu kullanır.
# Yoksa production build kırılır (Kural 57) — sessizce localhost'a düşmez.
# Sonda "/" olmamalı; kodda yine de kırpılır.
NEXT_PUBLIC_SITE_URL=https://ornek.vercel.app

# YALNIZCA performans ölçümü için. `?nopreload=1` parametresini prod build'de açar.
# Kural 43: Vercel'e EKLENMEZ — yayın build'inde tanımlı olmamalı.
# NEXT_PUBLIC_ALLOW_NOPRELOAD=1

# ---- Yönetim paneli (/admin) — Kural 80 ----
# Giriş şifresi. Vercel → Settings → Environment Variables → Production. Repoya YAZILMAZ.
# ADMIN_PASSWORD=
# İSTEĞE BAĞLI oturum imzası sırrı (≥ 32 kr). Yoksa DATABASE_URL'den türetilir.
# Değiştirmek tüm oturumları düşürür. Üretmek için: openssl rand -base64 48
# ADMIN_SESSION_SECRET=

# Depo (production): Neon ücretsiz Postgres, Vercel Marketplace → manch-v2'ye bağlı.
# DATABASE_URL'i Vercel KENDİSİ ekler (karar 2026-11-15).
# DATABASE_URL=
# İsteğe bağlı tablo öneki (varsayılan manch_). Bekçi gerçek DB'de manchtest_ kullanır.
# ADMIN_PG_PREFIX=
# Alternatif: Upstash Redis bağlanırsa (KV_REST_API_URL + KV_REST_API_TOKEN) o önceliklidir.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# YALNIZ yerel test: depo dosyada (.data/admin-store.json). Vercel'e EKLENMEZ.
# ADMIN_STORE=file
# YALNIZ yerel prod testi: `x-test-now` başlığıyla saati taklit et. Vercel'e EKLENMEZ.
# ORDER_TEST_CLOCK=1
